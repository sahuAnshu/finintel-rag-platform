# FinIntel RAG Service Configuration
PROJECT_NAME="FinIntel Enterprise RAG Engine"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Vector Store & Embedding Configuration
VECTOR_STORE_TYPE="faiss"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=384
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=4

# LLM Configuration (Optional: defaults to built-in semantic inference engine)
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_TEMPERATURE=0.1

# AWS S3 Storage (Optional)
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="finintel-financial-docs"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
